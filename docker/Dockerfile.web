# 前端：构建为静态产物，由 nginx 托管。
FROM node:22-alpine AS build

WORKDIR /app

# 先只拷依赖清单，让 npm ci 这层能被缓存
COPY web/package.json web/package-lock.json* ./
# 没有 lock 文件时退化为 npm install（首次开发阶段），有则用 ci 保证可复现
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY web ./

# API 地址在构建时注入（Vite 的环境变量是编译期替换的）
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine

COPY web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

# 用 127.0.0.1 而不是 localhost：alpine 里 localhost 会先解析到 IPv6 的 ::1，
# 而 nginx 只 listen 了 IPv4 —— busybox wget 连 ::1 被拒后不会回退，
# 健康检查会一直失败（服务本身完全正常，纯探活误报）。
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
    CMD wget -q --spider http://127.0.0.1/ || exit 1
