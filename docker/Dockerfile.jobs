# 离线任务。一次性容器，由 `docker compose run --rm jobs ...` 或 CI 触发。
FROM python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /uvx /bin/

# 剪辑域：ffmpeg/ffprobe CLI 负责拆条探测与剪裁转码（PyAV 只带库不带 CLI）；
# libglib2.0-0 是 opencv-headless 的运行依赖。常驻 worker 与一次性 jobs 共用本镜像。
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# 依赖层，说明见 Dockerfile.api
COPY pyproject.toml uv.lock .python-version ./
COPY api/pyproject.toml       api/pyproject.toml
COPY jobs/pyproject.toml      jobs/pyproject.toml
COPY embedding/pyproject.toml embedding/pyproject.toml
COPY libs libs

# jobs 声明了对 api 的依赖（eval.py 直接调用 api 里那份真实的检索函数），
# 所以这一步也会带上 api 的运行时依赖。
RUN uv sync --frozen --no-dev --package jobs

COPY jobs jobs
# eval.py 要 import api.app.services.search
COPY api api

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app

RUN useradd --create-home --uid 10001 appuser
USER appuser

# 默认不做任何事，由 compose run 指定子命令
ENTRYPOINT []
CMD ["python", "-m", "jobs", "--help"]
