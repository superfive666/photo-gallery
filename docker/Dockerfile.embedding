# 人脸检测 + embedding 推理服务。
# 构建上下文是仓库根目录（compose 里 context: .）。
FROM python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    # ⚠️ insightface 本身不读这个环境变量（它只认 FaceAnalysis(root=...) 参数）。
    # 这是**我们自己的**约定：下面的下载步骤和 embedding/app/model.py 都从这里读，
    # 从而保证「构建时下载到哪」和「运行时去哪找」是同一个目录。
    # 不用默认的 ~/.insightface 是因为构建以 root 跑、运行以 appuser 跑，家目录不同。
    INSIGHTFACE_HOME=/opt/insightface

# opencv-python-headless 只需要 glib，不需要 libGL ——
# 用 headless 版就是为了省掉整套 GUI 运行时（见根 pyproject 的 override-dependencies）。
RUN apt-get update && apt-get install -y --no-install-recommends \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 依赖层，说明见 Dockerfile.api
COPY pyproject.toml uv.lock .python-version ./
COPY api/pyproject.toml       api/pyproject.toml
COPY jobs/pyproject.toml      jobs/pyproject.toml
COPY embedding/pyproject.toml embedding/pyproject.toml
COPY libs libs

# embedding 只依赖 gallery-core 的基础部分（不带 [db] extra），
# 所以 sqlalchemy / asyncpg / pgvector 不会进这个镜像。
RUN uv sync --frozen --no-dev --package embedding

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app

# ---------------------------------------------------------------------------
# GPU 变体：**有意步出锁文件**的一步。
#
# onnxruntime 与 onnxruntime-gpu 提供同一个 `onnxruntime` 模块，装两个会互相覆盖；
# 而 insightface 硬依赖前者，没法用互斥 extra 干净地二选一（uv 的 override 是全局
# 按包名生效的，摘掉传递依赖时会连我们自己声明的那条一起摘掉）。
#
# 所以 CPU 路径完整入锁，GPU 在这里替换。版本号从已锁定的 CPU 版读出来，
# 保证两者始终一致 —— 不需要在 Dockerfile 里再维护一个版本常量。
#
#   docker compose build --build-arg EMBEDDING_GPU=true embedding
#
# ⚠️ onnxruntime-gpu 只是「会调用 CUDA 的代码」，CUDA 运行时库并不随它安装；
# nvidia-container-toolkit 也只往容器里注入**驱动**（libcuda.so.1），不含工具包。
# 缺库时 onnxruntime 不报致命错误，只是静默退回 CPU —— 首次上线就中过这个招
# （libcublasLt.so.13 找不到，GPU 机跑了十小时 CPU 推理）。
# 所以这里要装齐 CUDA 运行时轮子。清单来自对 onnxruntime-gpu 1.28.0 的
# providers_cuda.so 做 readelf/strings 实测：
#   NEEDED： libcublas(Lt).so.13  libcudart.so.13  libcurand.so.10
#   dlopen： libcudnn.so  libnvrtc.so.13
# （libcuda.so.1 是驱动，运行时由 nvidia-container-toolkit 注入，不装。）
# CUDA 13 的轮子统一装进 site-packages/nvidia/cu13/lib（cu12 时代是
# nvidia/<包名>/lib），下面的 nvidia/*/lib glob 对两种布局都成立。
# 代价：镜像大约 +1.5GB。ORT 升级到新 CUDA 大版本时，跟着换下面的版本约束。
#
# 还需要：宿主机装好 NVIDIA 驱动（CUDA 13 系需要 ≥580）与 nvidia container
# runtime，compose 里给 embedding 加 gpus，并设 EMBEDDING_USE_GPU=true。
# 见 docker/README.md。
# ---------------------------------------------------------------------------
ARG EMBEDDING_GPU=false
RUN if [ "$EMBEDDING_GPU" = "true" ]; then \
        set -eu; \
        ORT_VER="$(uv pip show onnxruntime | awk '/^Version:/{print $2}')"; \
        echo "替换 onnxruntime ${ORT_VER} → onnxruntime-gpu ${ORT_VER}"; \
        uv pip uninstall onnxruntime; \
        # ⚠️ 包名有坑：CUDA 13 起 NVIDIA 去掉了 -cu13 后缀（nvidia-cublas 13.x、
        # nvidia-cuda-runtime 13.x、nvidia-curand 10.x —— curand 按自己的 so 版本号走），
        # 只有 cuDNN 例外仍叫 nvidia-cudnn-cu13。而 PyPI 上 nvidia-cublas-cu13 之类
        # 带后缀的名字全是 0.0.1 的占位空包，装它会在 sdist 构建阶段直接炸
        # （首次真机构建就中过）。大版本钉死以匹配 ORT 1.28 要的 soname。
        uv pip install "onnxruntime-gpu==${ORT_VER}" \
            "nvidia-cublas>=13,<14" \
            "nvidia-cuda-runtime>=13,<14" \
            "nvidia-curand>=10,<11" \
            "nvidia-cudnn-cu13>=9,<10" \
            "nvidia-cuda-nvrtc>=13,<14"; \
        SITE="/app/.venv/lib/python3.11/site-packages"; \
        # 让动态链接器能找到 pip 装进 site-packages 的 CUDA 库
        ls -d "$SITE"/nvidia/*/lib > /etc/ld.so.conf.d/zz-nvidia-pip.conf; \
        # ORT 用不带版本号的名字 dlopen cudnn，而轮子里只有 libcudnn.so.9 —— 补软链
        for d in "$SITE"/nvidia/*/lib; do \
            for f in "$d"/lib*.so.*; do \
                [ -e "$f" ] || continue; \
                base="${f%%.so.*}.so"; \
                [ -e "$base" ] || ln -s "$(basename "$f")" "$base"; \
            done; \
        done; \
        ldconfig; \
        # 构建期就验证 CUDA provider 的静态依赖全部可解析，别把「运行时才发现
        # 缺库然后静默退回 CPU」的镜像交出去。libcuda.so.1 构建机上没有属正常。
        missing="$(ldd "$SITE/onnxruntime/capi/libonnxruntime_providers_cuda.so" \
                   | grep 'not found' | grep -v 'libcuda\.so\.1' || true)"; \
        if [ -n "$missing" ]; then \
            echo "CUDA provider 依赖缺失："; echo "$missing"; exit 1; \
        fi; \
        echo "CUDA provider 依赖齐全"; \
    fi

# ---------------------------------------------------------------------------
# 模型权重在构建时下载并打包进镜像（约 +300MB）。
# 不在运行时拉：否则每次冷启动都依赖外网，且首个请求会超时。
# ---------------------------------------------------------------------------
ARG MODEL_NAME=buffalo_l
RUN python - <<'PY'
import os
from insightface.app import FaceAnalysis

name = os.environ.get("MODEL_NAME", "buffalo_l")
root = os.environ["INSIGHTFACE_HOME"]
# root 必须显式传：insightface 不读环境变量，不传就下到构建用户（root）的
# ~/.insightface，运行时的 appuser 找不到，会在启动时联网重下。
# prepare() 会触发下载。ctx_id=-1 表示 CPU（构建机不一定有 GPU）。
app = FaceAnalysis(name=name, root=root,
                   allowed_modules=["detection", "recognition"],
                   providers=["CPUExecutionProvider"])
app.prepare(ctx_id=-1, det_size=(640, 640))
# 下载出问题时宁可让构建失败，也不要交付一个运行时才发现缺权重的镜像
expected = os.path.join(root, "models", name)
assert os.path.isdir(expected), f"模型目录不存在: {expected}"
print(f"model {name} downloaded to {expected}")
PY

COPY embedding embedding

# 非 root 运行。模型目录要能被读。
RUN useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /opt/insightface
USER appuser

EXPOSE 8000

# 单 worker：模型只加载一份，内存可控；并发由服务内部的 threadpool 提供。
# 多 worker 会让每个 worker 各加载一份模型，内存 ×N 且收益有限。
CMD ["uvicorn", "embedding.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
