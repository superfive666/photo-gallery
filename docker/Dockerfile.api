# 业务 API。不含任何模型 —— 镜像轻量，可自由扩容。
FROM python:3.11-slim

# uv 版本钉死：它决定 uv.lock 的解读方式，不该随构建时间漂移
COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    # 预编译 .pyc，冷启动快一点
    UV_COMPILE_BYTECODE=1 \
    # 容器里没有硬链接优化的余地，copy 更可预测
    UV_LINK_MODE=copy \
    # 只用基础镜像自带的解释器，不让 uv 偷偷下一个
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# ---------------------------------------------------------------------------
# 依赖层：只拷 workspace 的清单 + libs 源码。
# 改业务代码不会让这一层失效。
#
# 为什么要拷全部四个成员的 pyproject.toml：uv.lock 是整个 workspace 共享的一份，
# uv 需要读到所有成员的清单才能校验锁文件与之一致。
# libs 要拷源码是因为 gallery-core 是可编辑安装的成员，构建它需要包目录在位。
# ---------------------------------------------------------------------------
COPY pyproject.toml uv.lock .python-version ./
COPY api/pyproject.toml       api/pyproject.toml
COPY jobs/pyproject.toml      jobs/pyproject.toml
COPY embedding/pyproject.toml embedding/pyproject.toml
COPY libs libs

# --frozen：只按 uv.lock 装，锁文件与清单不一致就直接失败，不会静默重新解析
# --package api：只装 api 这个成员的依赖，不带 jobs/embedding 的
RUN uv sync --frozen --no-dev --package api

COPY api api

# 让 venv 里的可执行文件直接可用；PYTHONPATH 使 `api` 包可被导入
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app

RUN useradd --create-home --uid 10001 appuser
USER appuser

EXPOSE 8000

# 多 worker 没问题（不加载模型），但要注意 rate_limit 是进程内状态 ——
# 多 worker 下每个进程各有一份计数器，实际限流额度会被放大 N 倍。
# 需要严格限流时保持单 worker，或把 rate_limit 换成 Redis 实现。
CMD ["uvicorn", "api.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
