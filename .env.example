# 复制为 .env 并填写。生产环境的 .env 只存在于自建服务器上，权限 600，不经过 GitHub。

# ---------------------------------------------------------------------------
# 数据库
#
# 生产连宿主机上已有的 Postgres（不跑容器化 pg）：
#   DATABASE_URL=postgresql+asyncpg://gallery:<密码>@host.docker.internal:5432/photo_gallery
# 宿主机 pg 需要放行 docker 网段（listen_addresses / pg_hba / ufw），
# 建库、建用户、预建扩展的步骤见 docs/deployment.md 的「宿主机 Postgres」一节。
#
# 本地开发用 docker-compose.localdb.yml 里的容器化 pg（下面的默认值即可用），
# POSTGRES_* 三个变量只喂给那个容器，生产用不到。
# ---------------------------------------------------------------------------
POSTGRES_DB=photo_gallery
POSTGRES_USER=gallery
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://gallery:change-me@db:5432/photo_gallery

# ---------------------------------------------------------------------------
# embedding 服务
# ---------------------------------------------------------------------------
EMBEDDING_SERVICE_URL=http://embedding:8000
# 批量请求可能要跑几十秒，超时要比单张宽松
EMBEDDING_TIMEOUT_SECONDS=300
# InsightFace 模型包。换这个值意味着存量 embedding 全部失效，需要重跑 ingest --full。
MODEL_NAME=buffalo_l
MODEL_VERSION=1
# ONNXRuntime 线程数。设成宿主机物理核数附近；过大反而因争抢变慢。
ORT_NUM_THREADS=4
# 有 NVIDIA GPU 时设为 true，同时需要用 GPU 版镜像构建（见 docker/README.md）
EMBEDDING_USE_GPU=false
# 一次识别前向送多少张人脸。GPU 显存越大可以设越高；CPU 上设太大没有额外收益。
REC_BATCH_SIZE=64
# 单次 /extract/batch 最多几张图。给内存设天花板：每张图解码后是 W×H×3 字节。
MAX_BATCH_IMAGES=32

# ---------------------------------------------------------------------------
# 离线批量建库
# ---------------------------------------------------------------------------
# 一批多少张照片。实际值会与 embedding 服务报告的 MAX_BATCH_IMAGES 取小。
INGEST_BATCH_IMAGES=16
# 一批的字节上限（134217728 = 128MB）。只限张数不限字节，一批高像素原图会顶穿内存。
INGEST_BATCH_MAX_BYTES=134217728

# ---------------------------------------------------------------------------
# 检索阈值 —— ⚠️ 以下为文献占位值，上线前必须用评估集标定，见 docs/evaluation.md
# ---------------------------------------------------------------------------
FACE_MATCH_THRESHOLD=0.42
MIN_DET_SCORE=0.50
MIN_FACE_PX=40
MAX_RESULTS=200
# HNSW 查询召回参数；调高提升召回、增加延迟
HNSW_EF_SEARCH=100
# 从 HNSW 索引取多少个最近邻作为候选，再按阈值过滤。这是召回上限：
# 某人在库里的照片数超过它就会被截断。结果数逼近这个值时该调它，而不是调阈值。
SEARCH_CANDIDATES=500

# ---------------------------------------------------------------------------
# 鉴权
#
# 源站 photos.zrc.sg 本身是公开的，但本站仍然要邀请码：人脸检索创造了一个源站没有的
# 能力 —— 拿一张某人的照片就能把他在所有活动里的照片一次性聚齐。见 docs/privacy.md。
# ---------------------------------------------------------------------------
# 邀请码的 argon2 hash，不存明文。生成：python -m api.app.tools.hash_invite
# ⚠️ 值必须用单引号包住：argon2 hash 里全是 $，不加引号的话 docker compose
# 会把 $argon2id / $v / $m 当变量引用替换成空串 —— 登录直接 500。
# hash_invite 工具输出的就是带好引号的整行，原样粘贴即可。
#
# 这是**全相册管理码**（站主自用）。发给成员的码用绑定相册的邀请码，
# 存在数据库里而不是这里：python -m jobs invite create --album 2026-08-10 --label "发给谁"
INVITE_CODE_HASH=''
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12
# session cookie 的 Secure 属性。上了 HTTPS（Caddy）必须为 true；
# 内网 http 直测阶段设 false —— 否则浏览器拒收 cookie：登录 200 但下一个请求 401。
SESSION_COOKIE_SECURE=true
# 用于 search_audit 里 hash session/ip 的盐
AUDIT_HASH_SALT=change-me-as-well

# 限流。三层独立：session / IP（自动 ×3，NAT 下多人共用出口）/ 设备。
# 设备 id 在登录时绑进 JWT —— 清 cookie / 脚本不带 cookie 都换不来新设备身份，
# 想换必须重新登录过 captcha。硬边界仍是 session/IP 两层。
# 自拍检索与「浏览相册点脸检索」的设备限流互相独立、各自计数。
RATE_LIMIT_SEARCHES_PER_HOUR=30
RATE_LIMIT_SEARCHES_PER_DEVICE_PER_HOUR=3
RATE_LIMIT_FACE_SEARCHES_PER_DEVICE_PER_HOUR=4
MAX_UPLOAD_BYTES=10485760
MAX_SELFIES_PER_SEARCH=3
# 登录验证码的有效期（秒）。验证通过即作废，答错可对同一张图重试。
CAPTCHA_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# 素材来源
# 远端：photos.zrc.sg（公开、无需鉴权），相册地址形如
#   https://photos.zrc.sg/album/2026-08-10，slug 即数据库的 album 字段。
# 本地：把目录放到 ${MEDIA_ROOT}/media/<slug>/ 即成为本地相册（plans/0010）。
# ---------------------------------------------------------------------------
# auto = 相册粒度路由（本地目录存在走本地，其余走远端；已入库相册沿用库里记录）。
# local_dir / static_gallery 为强制单源模式（开发/评估用）。
SOURCE_ADAPTER=auto
SOURCE_BASE_URL=https://photos.zrc.sg
# 抓取纪律：默认保守，别把自己家的图库打挂
SOURCE_CONCURRENCY=4
SOURCE_RATE_LIMIT_PER_SECOND=5
SOURCE_USER_AGENT=zrc-face-search/0.1 (+https://faces.zrc.sg)

# 开发/评估用：SOURCE_ADAPTER=local_dir 时扫描的目录（一级子目录名 = album slug）
SOURCE_LOCAL_DIR=./sample-albums
# 评估集目录（含真人照片，不进 git）
EVAL_DIR=./eval

# 缩略图 —— 仅在源站未提供缩略图时才本地生成
THUMB_MAX_EDGE=256
THUMB_QUALITY=75

# 视频建库（plans/0008）。1 fps 足够定位「哪段有他」；短于 1 秒的露脸会漏，
# 不够用把采样率提到 2（GPU 成本线性翻倍）。超长/超大的直接跳过且不再重试。
VIDEO_SAMPLE_FPS=1.0
VIDEO_MAX_DURATION_S=1800
VIDEO_MAX_FRAMES=1800
VIDEO_MAX_BYTES=2147483648
# tracklet 聚合：gap 秒没接上就封段；余弦相似度为主、IoU 兜底
VIDEO_TRACK_GAP_S=3.0
VIDEO_TRACK_SIM=0.6
VIDEO_TRACK_IOU=0.3

# ---------------------------------------------------------------------------
# 镜像与部署（详见 docs/deployment.md）
# ---------------------------------------------------------------------------
# 镜像名前缀。没有镜像仓库 —— 构建就在部署的那台机器上做，镜像只存在于本机 docker，
# 所以这个值本地和生产都保持默认。想改用仓库时只改这一个变量（compose 与 workflow
# 都从它拼出 <前缀>-api / -jobs / -web / -embedding）。
IMAGE_PREFIX=photo-gallery
# 部署时由 workflow 用 sha-<short> 覆盖，用来区分版本、支持换 tag 回滚；
# 本地开发用 dev
IMAGE_TAG=dev
# 叠加哪些 compose 文件。写在这里而不是每次加 -f，
# 这样 workflow / make up / 手敲的 docker compose 全都一致带上。
#   本地开发（默认）：base + 容器化 pg
#   生产（GPU 机，连宿主机 pg）：COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.localdb.yml

# ---------------------------------------------------------------------------
# 其他
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
WEB_PORT=8080
# web 端口绑在哪个地址上。生产机前面有一层反向代理，所以设 127.0.0.1 ——
# ⚠️ 不只是少开一个端口：nginx.conf 里信任了 X-Forwarded-For，
# 这个端口一旦对外可达，客户端就能伪造它绕过 api 的按 IP 限流。
WEB_BIND=0.0.0.0
# 前端调用 api 的地址（构建时注入）
VITE_API_BASE_URL=/api

# ---------------------------------------------------------------------------
# 剪辑域（剧本驱动的选片+剪裁，见 docs/plans/0009 与 docs/media-edit.md）
# ---------------------------------------------------------------------------
# 专用盘在宿主机上的挂载点（容器内固定映射为 /photo-gallery）。
# 目录结构：media/<album>/ 原片（全局共享）；output/<workspace_id>/ 成片（按码隔离）；
#           luts/ 滤镜导入目录；agent-prompts/ 提示词热覆盖（可选）
MEDIA_ROOT_HOST=/photo-gallery
MEDIA_ROOT=/photo-gallery

# LLM（OpenAI-compatible /chat/completions）。三个都留空 = 无 LLM 回退路径：
# 按编号/空行切分剧本、原文即检索词 —— 流程完整但润色效果打折。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120

# Chinese-CLIP（图文检索模型，部署在 embedding 服务里）。
# 宿主机目录里放 image.onnx / text.onnx / vocab.txt，导出方法见 docs/media-edit.md。
# 文件缺失时人脸功能不受影响，剪辑建库会明确报错。
CLIP_MODEL_DIR_HOST=./clip-model
CLIP_MODEL_NAME=chinese-clip-vit-b-16
CLIP_MODEL_VERSION=1

# 融合检索 —— ⚠️ 经验占位值，待真实素材标定（P0）
# 相似度硬门槛：先过它，画质才参与排序（防"高清但不相关"上位）
EDIT_SIM_FLOOR=0.18
# 画质在融合排序里的权重上限
EDIT_QUALITY_WEIGHT=0.35
EDIT_TOP_K=5
EDIT_KNN_CANDIDATES=200
# 稳定性硬门槛（0 = 不启用，评审页人工兜底）
EDIT_MIN_STABILITY=0

# 拆条与渲染
SCENE_MIN_SECONDS=1.0
# 导出片段前后各留的余量（毫秒），给后期编排空间
RENDER_HANDLE_MS=1000
# H.264 CRF。16 ≈ 视觉无损；原片分辨率不缩放
RENDER_CRF=16
RENDER_PRESET=medium
WORKER_CPU_LIMIT=4
