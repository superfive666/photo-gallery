# 复制为 .env 并填写。生产环境的 .env 只存在于自建服务器上，权限 600，不经过 GitHub。

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
POSTGRES_DB=photo_gallery
POSTGRES_USER=gallery
POSTGRES_PASSWORD=change-me
# compose 内网地址；宿主机调试时改成 localhost:5432
DATABASE_URL=postgresql+asyncpg://gallery:change-me@db:5432/photo_gallery

# ---------------------------------------------------------------------------
# embedding 服务
# ---------------------------------------------------------------------------
EMBEDDING_SERVICE_URL=http://embedding:8000
EMBEDDING_TIMEOUT_SECONDS=60
# InsightFace 模型包。换这个值意味着存量 embedding 全部失效，需要 jobs recompute。
MODEL_NAME=buffalo_l
MODEL_VERSION=1
# ONNXRuntime 线程数。设成宿主机物理核数附近；过大反而因争抢变慢。
ORT_NUM_THREADS=4

# ---------------------------------------------------------------------------
# 检索阈值 —— ⚠️ 以下为文献占位值，上线前必须用评估集标定，见 docs/evaluation.md
# ---------------------------------------------------------------------------
FACE_MATCH_THRESHOLD=0.42
PERSON_MATCH_THRESHOLD=0.38
MIN_DET_SCORE=0.50
MIN_FACE_PX=40
MAX_RESULTS=200
# HNSW 查询召回参数；调高提升召回、增加延迟
HNSW_EF_SEARCH=100

# 聚类
CLUSTER_MIN_SAMPLES=3
CLUSTER_EPS=0.30

# ---------------------------------------------------------------------------
# 鉴权
# ---------------------------------------------------------------------------
# 邀请码的 argon2 hash，不存明文。生成：python -m api.tools.hash_invite <code>
INVITE_CODE_HASH=
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12
# 原图短效签名链接的签名密钥
SIGNED_URL_SECRET=change-me-too
SIGNED_URL_TTL_SECONDS=300
# 用于 search_audit 里 hash session/ip 的盐
AUDIT_HASH_SALT=change-me-as-well

# 限流
RATE_LIMIT_SEARCHES_PER_HOUR=30
MAX_UPLOAD_BYTES=10485760
MAX_SELFIES_PER_SEARCH=3

# ---------------------------------------------------------------------------
# 源站 photos.zrc.sg —— 具体字段取决于最终确定的接入方式，见 docs/data-source.md
# ---------------------------------------------------------------------------
SOURCE_ADAPTER=local_dir
SOURCE_BASE_URL=https://photos.zrc.sg
SOURCE_TOKEN=
# 开发/评估用：local_dir adapter 扫描的目录
SOURCE_LOCAL_DIR=/data/sample-albums
# 抓取纪律：默认保守，别把源站打挂
SOURCE_CONCURRENCY=4
SOURCE_RATE_LIMIT_PER_SECOND=5
SOURCE_USER_AGENT=zrc-face-search/0.1 (+https://faces.zrc.sg)

# 缩略图
THUMB_MAX_EDGE=256
THUMB_QUALITY=75

# ---------------------------------------------------------------------------
# 其他
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# 前端调用 api 的地址（构建时注入）
VITE_API_BASE_URL=/api
